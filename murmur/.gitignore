# Xcode — user-specific state (but keep the committed .xcodeproj itself)
xcuserdata/
*.xcuserstate
*.xcuserdatad/
DerivedData/
build/
.build/

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
Package.resolved

# Secrets — never commit keys (they live in the Keychain at runtime anyway)
*.env
Secrets.xcconfig
